# Set these in the Vercel project's Production environment, not in frontend code.
NODE_ENV=production
# Required for database readiness and Prisma; configure only in Production.
# Use Neon's pooled URL at runtime, with TLS required. Never prefix with VITE_.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/education_web?sslmode=require"
# For migrate deploy/status, inject the provider's direct (non-pooled) URL as
# DATABASE_URL in the operator session. Do not store it in this template.
# Provisioning, migrations, verification, and recovery: docs/production-database.md
CORS_ORIGIN=https://education-8mju.vercel.app
